# Copy this file to .env.local and fill in the project URL and publishable
# key from the Supabase dashboard (Connect, or Project Settings → API Keys).
# .env.local is git-ignored; never commit real values.
#
# Only the publishable key belongs here. Never put a secret or service-role
# key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Checkout (README, "Checkout"). Leave these unset to keep checkout OFF.
# All are server-only: none may be NEXT_PUBLIC_. Create the gateway secret
# with `node scripts/checkout-gateway-key.mjs` (it writes it here for you).
# CHECKOUT_ENABLED=true
# CHECKOUT_GATEWAY_SECRET=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# The single request header your host sets to the visitor's IP, from the
# host's documentation ("header:<name>"), or "none". Never x-forwarded-for.
# CLIENT_IP_SOURCE=
# Optional: hostnames a Turnstile check must have been solved on.
# TURNSTILE_ALLOWED_HOSTNAMES=
